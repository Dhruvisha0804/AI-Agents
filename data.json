    {
        "question": "List all employees working on 'Alian Hr module' project.",
        "query": {
          "collection": "projects",
          "aggregate": [
            {
              "$match": {
                "ProjectName": "Alian Hr module"
              }
            },
            {
              "$lookup": {
                "from": "users",
                "let": {
                  "assignees": {
                    "$map": {
                      "input": "$AssigneeUserId",
                      "as": "id",
                      "in": {
                        "$toObjectId": "$$id"
                      }
                    }
                  }
                },
                "pipeline": [
                  {
                    "$match": {
                      "$expr": {
                        "$in": ["$_id", "$$assignees"]
                      }
                    }
                  },
                  {
                    "$project": {
                      "Employee_Name": 1,
                      "_id": 0
                    }
                  }
                ],
                "as": "employees"
              }
            },
            {
              "$unwind": "$employees"
            },
            {
              "$project": {
                "employees.Employee_Name": 1,
                "_id": 0
              }
            }
          ]
        },
        "response": [
            { "Employee_Name": "Dhruvisha Jaiswal" },
            { "Employee_Name": "Sagar Vekariya" },
            { "Employee_Name": "Vivek Patel" },
            { "Employee_Name": "Rashesh Makwana" },
            { "Employee_Name": "Utkarshsinh Sodhaparmar" }
          ]          
      },
